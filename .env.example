# Supabase local PostgreSQL, shown by `npm run db:start`.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Sign the 12-hour staff session cookie. Replace this before any deployment.
AUTH_SESSION_SECRET="coffee-garden-local-session-secret-change-me"

# Optional local seed overrides. A hosted database requires explicit passwords.
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="coffee-owner-local"
SEED_KITCHEN_USERNAME="kitchen"
SEED_KITCHEN_PASSWORD="coffee-kitchen-local"
SEED_CASHIER_USERNAME="cashier"
SEED_CASHIER_PASSWORD="coffee-cashier-local"

# Production origin used inside downloaded table QR codes.
# PUBLIC_APP_URL="https://order.your-coffee-shop.vn"

# Use a direct PostgreSQL connection for Prisma migrations in hosted environments.
# DIRECT_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres"

# Before deploying, copy production values into the hosting provider instead of this file,
# then run `npm run production:seed-check`. See docs/DEPLOYMENT.md.
