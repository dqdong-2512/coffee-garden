generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderSource {
  CUSTOMER_QR
  POS
}

enum StaffRole {
  OWNER
  KITCHEN
  CASHIER
}

enum StaffPermissionCode {
  ORDER
  KITCHEN
  AUDIT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PAID
  VOIDED
}

enum ExpenseCategory {
  INGREDIENT
  SALARY
  ELECTRICITY
  WATER
  RENT
  MARKETING
  EQUIPMENT
  OTHER
}

enum IngredientUnit {
  GRAM
  MILLILITER
  PIECE
}

enum StockMovementType {
  STOCK_IN
  ADJUSTMENT
  CONSUMPTION
}

model StaffUser {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  displayName  String
  passwordHash String
  sessionVersion Int     @default(1)
  role         StaffRole
  isSuperAdmin Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]
  expenses     Expense[]
  stockMovements StockMovement[]
  dailyClosures DailyClosure[]
  permissionAssignments StaffPermissionAssignment[]

  @@index([role, isActive])
}

model Permission {
  code         StaffPermissionCode @id
  name         String
  description  String
  displayOrder Int                 @default(0)
  assignments StaffPermissionAssignment[]
}

model StaffPermissionAssignment {
  staffUserId   String              @db.Uuid
  permissionCode StaffPermissionCode
  assignedAt    DateTime            @default(now())
  staffUser     StaffUser           @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  permission    Permission          @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([staffUserId, permissionCode])
  @@index([permissionCode])
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  address   String   @default("")
  phone     String   @default("")
  taxCode   String   @default("")
  receiptFooter String @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories    Category[]
  products      Product[]
  diningTables  DiningTable[]
  orders        Order[]
  dailyCounters OrderDailyCounter[]
  payments      Payment[]
  expenses      Expense[]
  ingredients   Ingredient[]
  stockMovements StockMovement[]
  dailyClosures  DailyClosure[]
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  branchId     String    @db.Uuid
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name         String
  slug         String
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@unique([branchId, slug])
  @@unique([id, branchId])
}

model Product {
  id           String      @id @default(uuid()) @db.Uuid
  branchId     String      @db.Uuid
  categoryId   String      @db.Uuid
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category     Category    @relation(fields: [categoryId, branchId], references: [id, branchId], onDelete: Restrict)
  name         String
  slug         String
  description  String
  price        Int
  imageUrl     String?
  isAvailable  Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  recipeItems  RecipeItem[]

  @@unique([branchId, slug])
  @@index([branchId, categoryId, isAvailable])
}

model DiningTable {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@unique([branchId, code])
  @@unique([id, branchId])
}

model OrderDailyCounter {
  branchId     String   @db.Uuid
  businessDate DateTime @db.Date
  lastValue    Int      @default(0)
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([branchId, businessDate])
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  branchId           String      @db.Uuid
  tableId            String      @db.Uuid
  clientRequestId    String      @db.Uuid
  requestHash        String
  orderNo            String
  status             OrderStatus @default(PENDING)
  source             OrderSource @default(CUSTOMER_QR)
  subtotal           Int
  totalAmount        Int
  costAmount         Int         @default(0)
  customerNote       String?
  statusUpdatedAt    DateTime    @default(now())
  servedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  branch             Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table              DiningTable @relation(fields: [tableId, branchId], references: [id, branchId], onDelete: Restrict)
  items              OrderItem[]
  payment            Payment?
  stockMovements     StockMovement[]

  @@unique([branchId, clientRequestId])
  @@unique([branchId, orderNo])
  @@index([branchId, createdAt])
  @@index([branchId, status])
  @@index([tableId, createdAt])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  branchId    String        @db.Uuid
  orderId     String        @unique @db.Uuid
  createdById String        @db.Uuid
  method      PaymentMethod
  status      PaymentStatus @default(PAID)
  amount      Int
  reference   String?
  note        String?
  receivedAt  DateTime      @default(now())
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy   StaffUser     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([branchId, receivedAt])
  @@index([branchId, method, status])
  @@index([createdById, receivedAt])
}

model Expense {
  id            String          @id @default(uuid()) @db.Uuid
  branchId      String          @db.Uuid
  createdById   String          @db.Uuid
  category      ExpenseCategory
  amount        Int
  incurredAt    DateTime        @db.Date
  supplier      String
  description   String
  paymentMethod PaymentMethod
  externalRef   String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy     StaffUser       @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([branchId, incurredAt])
  @@index([branchId, category, incurredAt])
  @@index([createdById, createdAt])
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  productId   String   @db.Uuid
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  itemNote    String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Ingredient {
  id                String         @id @default(uuid()) @db.Uuid
  branchId          String         @db.Uuid
  name              String
  slug              String
  unit              IngredientUnit
  currentQuantity   Int            @default(0)
  lowStockThreshold Int            @default(0)
  costPerUnit       Int            @default(0)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  recipeItems       RecipeItem[]
  stockMovements    StockMovement[]

  @@unique([branchId, slug])
  @@index([branchId, isActive])
}

model RecipeItem {
  id           String     @id @default(uuid()) @db.Uuid
  productId    String     @db.Uuid
  ingredientId String     @db.Uuid
  quantity     Int
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@index([ingredientId])
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  branchId      String            @db.Uuid
  ingredientId  String            @db.Uuid
  createdById   String?           @db.Uuid
  orderId       String?           @db.Uuid
  type          StockMovementType
  quantity      Int
  balanceAfter  Int
  unitCost      Int
  totalCost     Int
  note          String
  externalRef   String?           @unique
  createdAt     DateTime          @default(now())
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ingredient    Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  createdBy     StaffUser?        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, ingredientId])
  @@index([branchId, createdAt])
  @@index([ingredientId, createdAt])
}

model DailyClosure {
  id                  String    @id @default(uuid()) @db.Uuid
  branchId            String    @db.Uuid
  createdById         String    @db.Uuid
  businessDate        DateTime  @db.Date
  openingCash         Int
  cashSales           Int
  cashExpenses        Int
  expectedCash        Int
  countedCash         Int
  cashDifference      Int
  bankTransferTotal   Int
  paidTotal           Int
  voidedTotal         Int
  unpaidTotal         Int
  paymentCount        Int
  voidedPaymentCount  Int
  unpaidOrderCount    Int
  note                String?
  closedAt            DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  branch              Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy           StaffUser @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([branchId, businessDate])
  @@index([branchId, closedAt])
  @@index([createdById, closedAt])
}
