generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderSource {
  CUSTOMER_QR
  POS
}

enum StaffRole {
  OWNER
  KITCHEN
  CASHIER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PAID
  VOIDED
}

enum ExpenseCategory {
  INGREDIENT
  SALARY
  ELECTRICITY
  WATER
  RENT
  MARKETING
  EQUIPMENT
  OTHER
}

model StaffUser {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  displayName  String
  passwordHash String
  role         StaffRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]
  expenses     Expense[]

  @@index([role, isActive])
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories    Category[]
  products      Product[]
  diningTables  DiningTable[]
  orders        Order[]
  dailyCounters OrderDailyCounter[]
  payments      Payment[]
  expenses      Expense[]
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  branchId     String    @db.Uuid
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name         String
  slug         String
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@unique([branchId, slug])
  @@unique([id, branchId])
}

model Product {
  id           String      @id @default(uuid()) @db.Uuid
  branchId     String      @db.Uuid
  categoryId   String      @db.Uuid
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category     Category    @relation(fields: [categoryId, branchId], references: [id, branchId], onDelete: Restrict)
  name         String
  slug         String
  description  String
  price        Int
  imageUrl     String?
  isAvailable  Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]

  @@unique([branchId, slug])
  @@index([branchId, categoryId, isAvailable])
}

model DiningTable {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@unique([branchId, code])
  @@unique([id, branchId])
}

model OrderDailyCounter {
  branchId     String   @db.Uuid
  businessDate DateTime @db.Date
  lastValue    Int      @default(0)
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([branchId, businessDate])
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  branchId           String      @db.Uuid
  tableId            String      @db.Uuid
  clientRequestId    String      @db.Uuid
  requestHash        String
  orderNo            String
  status             OrderStatus @default(PENDING)
  source             OrderSource @default(CUSTOMER_QR)
  subtotal           Int
  totalAmount        Int
  customerNote       String?
  statusUpdatedAt    DateTime    @default(now())
  servedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  branch             Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table              DiningTable @relation(fields: [tableId, branchId], references: [id, branchId], onDelete: Restrict)
  items              OrderItem[]
  payment            Payment?

  @@unique([branchId, clientRequestId])
  @@unique([branchId, orderNo])
  @@index([branchId, createdAt])
  @@index([branchId, status])
  @@index([tableId, createdAt])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  branchId    String        @db.Uuid
  orderId     String        @unique @db.Uuid
  createdById String        @db.Uuid
  method      PaymentMethod
  status      PaymentStatus @default(PAID)
  amount      Int
  reference   String?
  note        String?
  receivedAt  DateTime      @default(now())
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy   StaffUser     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([branchId, receivedAt])
  @@index([branchId, method, status])
  @@index([createdById, receivedAt])
}

model Expense {
  id            String          @id @default(uuid()) @db.Uuid
  branchId      String          @db.Uuid
  createdById   String          @db.Uuid
  category      ExpenseCategory
  amount        Int
  incurredAt    DateTime        @db.Date
  supplier      String
  description   String
  paymentMethod PaymentMethod
  externalRef   String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy     StaffUser       @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([branchId, incurredAt])
  @@index([branchId, category, incurredAt])
  @@index([createdById, createdAt])
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  productId   String   @db.Uuid
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  itemNote    String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}
